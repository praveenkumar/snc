# Disk partitions configuration using osbuild disk customizations
# This creates: EFI system partition, boot partition, and LVM volume group
# BIOS boot partition and GPT disk label are automatically handled by osbuild
# when EFI system partition is present
[[customizations.disk.partitions]]
type = "plain"
fs_type = "xfs"
mountpoint = "/boot"
minsize = "800 MiB"

[[customizations.disk.partitions]]
type = "lvm"
name = "rhel"
minsize = "10 GiB"

[[customizations.disk.partitions.logical_volumes]]
name = "root"
mountpoint = "/"
fs_type = "xfs"
minsize = "REPLACE_LVM_SYSROOT_SIZE"

[[customizations.user]]
name = "core"
description = "Default user"
home = "/home/core"
shell = "/bin/bash"
groups = ["wheel"]
key = "REPLACE_CORE_AUTHORIZED_KEYS_CONTENTS"

# Image mode: osbuild handles disk partitions, users, and groups
# Kickstart handles remaining customizations (files, hostname, services, etc.)
[customizations.installer.kickstart]
contents = """
lang en_US.UTF-8
keyboard us
timezone UTC
text
reboot

# Configure network to use DHCP and activate on boot
network --bootproto=dhcp --device=link --activate --onboot=on

# Disk initialization (partitioning handled by osbuild disk customizations above)
zerombr
clearpart --all

# Lock root user account
rootpw --lock


%post --log=/var/log/anaconda/post-install.log --erroronfail

# Support to boot for UEFI and legacy mode
grub2-install --target=i386-pc /dev/vda

# Make podman rootless available
mkdir -p /home/core/.config/systemd/user/default.target.wants
ln -s /usr/lib/systemd/user/podman.socket /home/core/.config/systemd/user/default.target.wants/podman.socket

mkdir -p /home/core/.config/containers
tee /home/core/.config/containers/containers.conf <<EOF
[containers]
netns="bridge"
rootless_networking="cni"
EOF

# Make sure core user directory contents ownership is correct
chown -R core:core /home/core/

touch /etc/containers/podman-machine

tee /etc/containers/registries.conf.d/999-podman-machine.conf <<EOF
unqualified-search-registries=["docker.io"]
EOF

%end
"""
